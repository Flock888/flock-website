{
  "name": "flock-website",
  "compatibility_date": "2026-11-01",
  "main": "src/worker.js",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "flockhongkong.com", "custom_domain": true },
    { "pattern": "www.flockhongkong.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
